{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "borail-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "borail-notifications",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
